

# --- Microsoft Azure ---
AZURE_RESOURCE_GROUP=cloudnotes-rg

# Must be one of the allowed regions:
# germanywestcentral, switzerlandnorth, norwayeast, spaincentral, francecentral
AZURE_LOCATION=germanywestcentral

# --- Domain (free ACI subdomain, no extra service needed) ---
# Must be globally unique, lowercase, letters/numbers/hyphens only
# Your app will be at: https://<AZURE_DNS_LABEL>.<AZURE_LOCATION>.azurecontainer.io
AZURE_DNS_LABEL=cloudnotes-yourname

# --- Database ---
POSTGRES_DB=cloudnotes
POSTGRES_USER=cloudnotes_user
POSTGRES_PASSWORD=change-this-to-a-strong-password

# --- Application ---
# Leave empty to auto-generate with openssl rand -hex 32
SECRET_KEY=

# --- Let's Encrypt ---
LETSENCRYPT_EMAIL=your-university@email.com
